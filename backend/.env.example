# =============================================================================
# 环境变量模板
# -----------------------------------------------------------------------------
# 使用方式：
#   1. 本地开发推荐运行仓库根目录的 ./dev.sh --init，由脚本生成随机凭据。
#   2. 手动部署时复制为 .env，并补齐下面留空的凭据。
#   3. .env 只保存在本地或部署平台，绝不能提交到 Git。
#
# 【前端转全栈知识点】
# 什么是环境变量：
#   操作系统层面的"全局配置"，所有进程都能读
#   开发/测试/生产环境用不同的值，但代码完全一样
#
# 为什么用 .env 而不是写死在代码里：
#   - 密钥（API Key、数据库密码）绝对不能进 git
#   - 不同环境（本地/测试/生产）配置不同
#   - 改配置不用改代码、重新部署
#
# 加载机制：
#   后端启动时用 dotenv 库读取 .env 文件，注入到 process.env
# =============================================================================

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
NODE_ENV=development                    # development | production | test
PORT=5174                               # 后端服务监听端口
# 注：避免使用 5000（macOS AirPlay 占用）、3000（前端 vite 占用）

# 前端静态文件根目录（生产合并部署时启用，开发留空）
# - 留空：不挂载静态服务（开发模式，前后端分别启动）
# - 绝对路径：Hono 会 serve 该目录下的前端构建产物（含 SPA 路由回退）
# 容器部署示例：STATIC_ROOT=/app/dist
# 本地生产调试：STATIC_ROOT=/Users/your-name/projects/drama-predict-web/dist
STATIC_ROOT=

# -----------------------------------------------------------------------------
# PostgreSQL 数据库
# -----------------------------------------------------------------------------
POSTGRES_DB=drama_predict
POSTGRES_USER=drama
POSTGRES_PASSWORD=

# 应用代码连接数据库用的 URL（Drizzle ORM 读这个）
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://drama:@localhost:5432/drama_predict

# -----------------------------------------------------------------------------
# Redis（任务队列 + 缓存）
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# MinIO 对象存储（S3 兼容）
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false                     # 本地用 http，生产用 https
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=drama-exports              # 存储桶名（存导出文件的"文件夹"）

# -----------------------------------------------------------------------------
# 阿里云 OSS 图床（AI 生成图片持久化）
# -----------------------------------------------------------------------------
# 用途：image-config/generate 返回的临时 URL 转存为永久 OSS URL
# 配置优先级：DB（admin 后台）> env（这里）
#   - admin 在后台保存后，DB 值生效，env 仅作为兜底
#   - 留空表示不启用 OSS 图床功能（不会影响后端启动）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=oss-cn-hangzhou              # 地域：oss-cn-hangzhou / oss-cn-shanghai / oss-cn-beijing
OSS_BUCKET=                             # bucket 名（小写字母+数字+短横线）
OSS_ENDPOINT=                           # 留空用 region 自动推导；私有化部署可填
OSS_CUSTOM_DOMAIN=                      # CDN 加速域名（如 https://cdn.example.com），留空走 bucket 直链
OSS_PATH_PREFIX=drama/images            # 文件虚拟目录前缀
OSS_TIMEOUT_MS=60000                    # SDK 单次操作超时

# -----------------------------------------------------------------------------
# Puppeteer（阶段 9：PDF 导出）
# -----------------------------------------------------------------------------
# Chromium 可执行文件路径：
#   - 留空：puppeteer 自动下载并使用内置 Chromium（开发推荐）
#   - 指定路径：用系统 Chromium（生产容器部署时用，避免镜像膨胀）
# macOS 系统示例：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux 容器示例：/usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# -----------------------------------------------------------------------------
# JWT 鉴权
# -----------------------------------------------------------------------------
# 【重要】生产环境务必改成 32 位以上的随机字符串
# 生成强密码命令：openssl rand -hex 32
# 至少 32 个字符；./dev.sh --init 会自动生成随机值
JWT_SECRET=
JWT_EXPIRES_IN=7d                       # Token 有效期
REFRESH_TOKEN_EXPIRES_IN=30d            # 刷新 Token 有效期

# -----------------------------------------------------------------------------
# LLM Provider（一期服务端统一配置）
# -----------------------------------------------------------------------------
# 支持：openai | anthropic | qwen | deepseek
# 国内推荐：qwen（通义千问，阿里云）或 deepseek
LLM_PROVIDER=qwen
# 留空也可以启动，之后在管理员后台配置；不要把真实 Key 写进此文件并提交。
LLM_API_KEY=
LLM_MODEL=qwen-max
# 通义千问的 OpenAI 兼容模式地址
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM 调用超时（毫秒）
LLM_TIMEOUT_MS=90000

# -----------------------------------------------------------------------------
# CORS 跨域
# -----------------------------------------------------------------------------
# 允许哪个前端地址访问后端（逗号分隔支持多个）
# 开发环境：你的前端实际端口（vite 默认 5173，本项目前端配的是 3000）
# 生产环境：你的域名（如 https://drama.example.com）
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# 任务超时阈值（毫秒），前端长操作的转黄/转红阈值
# -----------------------------------------------------------------------------
ANALYZE_TIMEOUT_WARNING_MS=45000        # 分析：45s 转黄
ANALYZE_TIMEOUT_FAILURE_MS=90000        # 分析：90s 转红
EXPORT_TIMEOUT_FAILURE_MS=40000         # 导出：40s 转红

# -----------------------------------------------------------------------------
# 日志级别
# -----------------------------------------------------------------------------
# development: debug（详细，含 SQL、请求体）
# production: info（简洁，只记关键事件）
LOG_LEVEL=debug

# 首次执行 db:seed 时使用；./dev.sh --init 会自动生成随机值。
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
